parameters:
    level: 7
    paths:
        - src
    excludePaths:
        # These bind Pest's expect()->extend() closures ($this is the expectation,
        # resolved by Pest at runtime) and Pest's @internal Bootable plugin contract.
        # Neither is statically analysable in isolation; both are exercised by the
        # test suite (Expectations proven to register both ways).
        - src/Expectations/Expectations.php
        - src/Pest/Plugin.php
    ignoreErrors:
        # DriverMatrix is a dev-only test helper: reading TESTING_DB_* env at test time
        # is its whole purpose (config is never cached in a Testbench run). The
        # "env outside config/" rule targets app runtime code, not a matrix entry point.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: src/Database/DriverMatrix.php
        # Fixture-support trait shipped for consumers' suites; nothing in this package's
        # own src/ uses it, so PHPStan cannot see a using class (it is exercised by the
        # test fixtures under tests/, outside the analysed paths).
        -
            identifier: trait.unused
            paths:
                - src/Fixtures/Concerns/CountsCreations.php
                - src/Fixtures/Concerns/RecordsLocks.php

{
    "name": "roundly-consulting/testing-for-laravel",
    "description": "Dev-only test machinery for Laravel packages and apps: base test cases, a structural migration-order pin, and Pest expectations that can always fail",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "testing",
        "pest",
        "testbench"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/testing-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/testing-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.1.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "suggest": {
        "ext-pcntl": "Needed by Concurrency\\Racer to fork a second database session; without it Racer::available() is false",
        "ext-posix": "Needed by Concurrency\\Racer to end the forked racer with SIGKILL; without it Racer::available() is false"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Testing\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Testing\\Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "pest": {
            "plugins": [
                "RoundlyConsulting\\Testing\\Pest\\Plugin"
            ]
        }
    }
}
